#!/usr/bin/env python3
"""Forward product browser commands; never import legacy login storage."""
import os
from pathlib import Path
import sys
import subprocess

binary = os.environ.get("MYSTOCKTRACER_AGENT_BROWSER_REAL") or os.environ.get("A_STOCK_AGENT_BROWSER_REAL", "")
if not binary or not Path(binary).is_file():
    print("mystocktracer browser runtime unavailable", file=sys.stderr)
    sys.exit(127)
sys.exit(subprocess.call([binary, *sys.argv[1:]]))
